# Copy to .env and fill in. .env is git-ignored.

# Host-side connection string (docker-compose maps the DB to port 6543)
DATABASE_URL=postgresql://postgres:password@localhost:6543/postgres
POSTGRES_PASSWORD=password

# Financial Modeling Prep API key (ingestion jobs)
FMP_API_KEY=

# Anthropic API key (Sentinel, SQL, and Synthesizer agents)
ANTHROPIC_API_KEY=
